# Copie para .env e TROQUE as senhas:  cp .env.example .env
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

TZ=America/Sao_Paulo

# Banco do Zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=troque-esta-senha-do-banco
POSTGRES_DB=zabbix

# Login do Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-do-grafana

# Usuário que o Grafana usa para ler dados do Zabbix.
# O Zabbix começa com Admin / zabbix. Depois de trocar a senha no Zabbix,
# atualize aqui e rode: docker compose up -d grafana
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=zabbix

# (Opcional) Alertas no Telegram – o zabbix-setup configura tudo sozinho se preencher.
# Token: fale com @BotFather → /newbot.   Chat ID: fale com @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
